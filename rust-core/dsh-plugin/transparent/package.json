{
  "name": "sic-transparent-host",
  "version": "0.2.0",
  "type": "module",
  "main": "cordis-entry.mjs",
  "exports": {
    ".": "./cordis-entry.mjs",
    "./client": "./native-client.js",
    "./api": "./index.mjs",
    "./plugin": "./plugin.mjs",
    "./bindings": "./binding-store.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-0 <0.3",
    "node": ">=22.19.0"
  },
  "description": "Opt-in native SIC context editing inside existing Harness Provider routes",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-0 <0.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-0 <0.3",
    "@deepseek-ai/dsh-agent": ">=0.2.1-0 <0.3",
    "@deepseek-ai/dsh-session": ">=0.2.1-0 <0.3",
    "@deepseek-ai/dsh-jobs": ">=0.2.1-0 <0.3",
    "sharp": "^0.35.5"
  },
  "peerDependenciesMeta": {
    "sharp": { "optional": true }
  },
  "bin": {
    "sic-bind-session": "./bind-session.mjs"
  }
}
